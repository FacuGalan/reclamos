{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git merge origin/main*)",
      "Bash(gh api user*)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(gh pr *)",
      "Bash(php artisan *)",
      "Bash(composer install*)",
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(npm run *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)"
    ]
  }
}
